# ==============================================================================
# DineFlow Admin Portal — Environment Configuration
# Shared Firebase Project: dine-flow-v1
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Side Firebase Configuration (Safe for Browser Use — VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=dine-flow-v1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dine-flow-v1
VITE_FIREBASE_STORAGE_BUCKET=dine-flow-v1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Public URL of the DineFlow Restaurant Application (for deep links to live tenant pages)
VITE_DINEFLOW_APP_URL=https://dineflowv1.vercel.app

# ------------------------------------------------------------------------------
# 2. Server-Side Firebase Admin SDK Secrets (Vercel Serverless Functions ONLY)
# NEVER prefix these with VITE_ and NEVER expose to the browser!
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=dine-flow-v1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@dine-flow-v1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Automation Secret (Server-Side only)
# ------------------------------------------------------------------------------
DINEFLOW_WEBHOOK_SECRET=whsec_...
N8N_WEBHOOK_URL=https://sparkscale.app.n8n.cloud/webhook/dineflow
